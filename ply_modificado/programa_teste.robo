// Exemplo 1: Desenho de um Quadrado com Repetição e Troca de Cor
reset;
cor "AZUL";
passo = 50 + 10;
print "Iniciando percurso do quadrado:";

repetir 4 {
    frente passo;
    direita 90;
}

status;

// Deslocamento com caneta levantada
levantar;
frente 100;
abaixar;
cor "VERDE";
frente 30;

status;

